# Kanonische Quelle: /media/SSD/Sichern/claude/pi-setup-portal/pi-setup-portal.service
# NICHT direkt in den Deployment-Kopien unter honigbox-webseite/setup/ oder
# imker-app/setup/ bearbeiten - siehe Warnhinweis in pi_setup_portal.py.
# Aendern, dann im kanonischen Ordner ./sync.sh ausfuehren.
[Unit]
Description=Pi-Setup-Portal – Setup-Seite inkl. WLAN-Einstellungen, Backup und Update fuer alle registrierten Apps (Port 80)
After=NetworkManager.service
Wants=NetworkManager.service
# Bewusst KEIN Before=<app>.service: jede registrierte App soll unabhaengig
# davon sofort starten, auch wenn WLAN nie eingerichtet wird (reine Kabelnutzung).

[Service]
Type=simple
# Nur vorhanden, falls Port 80 beim Einrichten schon belegt war - setzt dann
# PI_SETUP_LANDING_PORT auf einen Ausweich-Port.
EnvironmentFile=-/etc/default/pi-setup-portal
ExecStart=/opt/pi-setup-portal/pi-setup-portal.sh
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
