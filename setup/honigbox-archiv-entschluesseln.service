[Unit]
Description=HonigBox - Archiv- und Bilder-LUKS-Container oeffnen/anlegen
# Bewusst KEIN Requires=/Before= zu honigbox-galerie.service in beide
# Richtungen: die Schluesseleingabe passiert ueber die Route
# /archiv-schluessel in galerie_server.py selbst. Wuerde dieser Dienst
# erst NACH abgeschlossener Entschluesselung starten duerfen, koennte
# niemand je einen Schluessel eingeben (Deadlock). galerie_server.py
# prueft den Status stattdessen laufend selbst (siehe archiv_bereit()).
After=local-fs.target haveged.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/opt/honigbox/archiv_entschluesseln.sh
# Bewusst KEIN Zeitlimit: das Skript wartet ohne Timeout auf eine
# Schluessel-Eingabe (man koennte laenger suchen muessen, wo der Schluessel
# gesichert wurde) - ein von systemd erzwungener SIGKILL wuerde diese
# Wartezeit von aussen kappen und (schlimmer) potenziell mitten in einem
# cryptsetup/mkfs-Aufruf zuschlagen und einen korrupten Container
# hinterlassen. Restart=on-failure bleibt als Sicherheitsnetz fuer einen
# echten Absturz (z.B. OOM) - ein Neustart des Dienstes faengt einfach
# wieder von vorn mit Warten an, ohne Datenverlust.
TimeoutStartSec=0
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
